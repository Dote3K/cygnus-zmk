if SHIELD_CYGNUS_LEFT || SHIELD_CYGNUS_RIGHT || SHIELD_CYGNUS_DONGLE

config ZMK_SPLIT
    default y

endif

if SHIELD_CYGNUS_LEFT || SHIELD_CYGNUS_RIGHT

config ZMK_SPLIT_ROLE_CENTRAL
    default n

config BT_MAX_CONN
    default 1

config BT_MAX_PAIRED
    default 1

# battery: halves deep-sleep after 15 min without key presses and wake on the next press
# (the matrix is a wakeup-source); the USB-powered dongle never sleeps
config ZMK_SLEEP
    default y

config ZMK_IDLE_SLEEP_TIMEOUT
    default 900000

config ZMK_BATTERY_REPORT_INTERVAL
    default 300

endif

if SHIELD_CYGNUS_DONGLE

config ZMK_KEYBOARD_NAME
    default "Cygnus"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif